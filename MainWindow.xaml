<Window x:Class="DynamicIsland.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dynamic Island"
        Icon="assets/icon.ico"
        Width="110" Height="32"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SizeToContent="Manual"
        SizeChanged="Window_SizeChanged">

    <Window.Resources>
        <!-- Animation cho từng cột sóng nhạc: nhảy lên xuống liên tục, lệch pha nhau
             để trông tự nhiên như equalizer thật, không đều tăm tắp -->
        <Storyboard x:Key="BarAnim1" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetProperty="(FrameworkElement.Height)"
                              From="4" To="16" Duration="0:0:0.28"/>
        </Storyboard>
        <Storyboard x:Key="BarAnim2" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetProperty="(FrameworkElement.Height)"
                              From="4" To="22" Duration="0:0:0.36" BeginTime="0:0:0.1"/>
        </Storyboard>
        <Storyboard x:Key="BarAnim3" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetProperty="(FrameworkElement.Height)"
                              From="4" To="12" Duration="0:0:0.22" BeginTime="0:0:0.05"/>
        </Storyboard>
    </Window.Resources>

    <Grid>
        <!-- Viên "pill" đen bo tròn - đây chính là Dynamic Island. Border phủ kín cửa sổ
             nên vùng trong suốt không che mất thao tác chuột xuống ứng dụng bên dưới -->
        <Border x:Name="IslandBorder"
                CornerRadius="16"
                Background="#FF1C1C1E"
                BorderBrush="#33FFFFFF"
                BorderThickness="0.6"
                MouseLeftButtonDown="IslandBorder_MouseDown"
                MouseMove="IslandBorder_MouseMove"
                MouseLeftButtonUp="IslandBorder_MouseUp"
                MouseRightButtonUp="IslandBorder_RightClick">
            <Border.Effect>
                <DropShadowEffect Color="Black" BlurRadius="14" ShadowDepth="2" Opacity="0.35"/>
            </Border.Effect>

            <Grid Margin="12,0">

                <!-- ===== TRẠNG THÁI 1: THU GỌN (mặc định / nghe nhạc thu nhỏ) ===== -->
                <StackPanel x:Name="CollapsedContent"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <Rectangle x:Name="MiniBar1" Width="3" Height="4" RadiusX="1.5" RadiusY="1.5" Fill="#FF3A3A3A" VerticalAlignment="Center"/>
                    <Rectangle x:Name="MiniBar2" Width="3" Height="4" RadiusX="1.5" RadiusY="1.5" Fill="#FF3A3A3A" VerticalAlignment="Center" Margin="3,0,0,0"/>
                    <Rectangle x:Name="MiniBar3" Width="3" Height="4" RadiusX="1.5" RadiusY="1.5" Fill="#FF3A3A3A" VerticalAlignment="Center" Margin="3,0,0,0"/>
                </StackPanel>

                <!-- ===== TRẠNG THÁI 2: MỞ RỘNG - ĐANG PHÁT NHẠC ===== -->
                <StackPanel x:Name="ExpandedMusicContent"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Visibility="Collapsed">
                    <Border Width="28" Height="28" CornerRadius="6" Background="#FF444444" ClipToBounds="True">
                        <Image x:Name="AlbumArtImage" Stretch="UniformToFill"/>
                    </Border>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="TitleText" Text="Chưa có nhạc" Foreground="White" FontSize="11" FontWeight="Medium" MaxWidth="130" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="ArtistText" Text="" Foreground="#FF999999" FontSize="10" MaxWidth="130" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <!-- Sóng nhạc cỡ lớn bên phải, giống Dynamic Island thật -->
                    <StackPanel Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Center">
                        <Rectangle x:Name="BigBar1" Width="3" Height="6" RadiusX="1.5" RadiusY="1.5" Fill="#FF4CD964" VerticalAlignment="Center"/>
                        <Rectangle x:Name="BigBar2" Width="3" Height="6" RadiusX="1.5" RadiusY="1.5" Fill="#FF4CD964" VerticalAlignment="Center" Margin="3,0,0,0"/>
                        <Rectangle x:Name="BigBar3" Width="3" Height="6" RadiusX="1.5" RadiusY="1.5" Fill="#FF4CD964" VerticalAlignment="Center" Margin="3,0,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- ===== TRẠNG THÁI 3: MỞ RỘNG - THÔNG BÁO / CUỘC GỌI ===== -->
                <StackPanel x:Name="ExpandedNotificationContent"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Visibility="Collapsed">
                    <Border Width="28" Height="28" CornerRadius="14" Background="#FF444444" ClipToBounds="True">
                        <Image x:Name="NotifIconImage" Stretch="UniformToFill"/>
                    </Border>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="NotifTitleText" Text="" Foreground="White" FontSize="11" FontWeight="Medium" MaxWidth="170" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="NotifBodyText" Text="" Foreground="#FF999999" FontSize="10" MaxWidth="170" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </StackPanel>

            </Grid>
        </Border>
    </Grid>
</Window>
